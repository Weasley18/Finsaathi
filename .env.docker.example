# Copy this file to .env, then fill in the three secrets below.
#   cp .env.docker.example .env
#
# Generate values with:
#   JWT_SECRET      node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   ENCRYPTION_KEY  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   MINIO_SECRET_KEY any password of 8+ characters
# (or: openssl rand -hex 64 / openssl rand -base64 32)

POSTGRES_DB=finsaathi
POSTGRES_USER=finsaathi
POSTGRES_PASSWORD=finsaathi
DATABASE_URL=postgresql://finsaathi:finsaathi@postgres:5432/finsaathi?schema=public

REDIS_URL=redis://redis:6379
ML_SERVICE_URL=http://ml-service:8000
CHROMA_URL=http://chromadb:8000
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# REQUIRED — the stack refuses to start without these
JWT_SECRET=
# Base64 encoded 32-byte key for AES-256-GCM (PII fields + uploaded documents).
# Keep it safe: data encrypted with it cannot be read with any other key.
ENCRYPTION_KEY=

# Object storage for uploaded documents (MinIO, S3-compatible)
MINIO_ACCESS_KEY=finsaathi
MINIO_SECRET_KEY=
MINIO_BUCKET=finsaathi-docs

# Optional, used for translation via HuggingFace API (falls back to Ollama)
HUGGINGFACE_API_KEY=

# OTP delivery. Leave MSG91_AUTH_KEY empty for a local demo.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=FINSTH
# Local demo only: with no SMS gateway configured, return the OTP in the
# /auth/send-otp response so the apps can show it. NEVER enable on a real deployment.
EXPOSE_DEV_OTP=true

ALLOWED_ORIGINS=http://localhost:3000

# Used at web build time
VITE_API_URL=/api
