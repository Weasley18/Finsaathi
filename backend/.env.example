# ─── Database ────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, or self-hosted)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ─── JWT ─────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS"

# ─── Encryption (AES-256-GCM for PII fields) ─────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY"

# ─── Redis ───────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── MinIO (Object Storage for documents) ────────────────────────
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="REPLACE_WITH_MINIO_ACCESS_KEY"
MINIO_SECRET_KEY="REPLACE_WITH_MINIO_SECRET_KEY"
MINIO_BUCKET="finsaathi-docs"

# ─── Ollama (Local LLM) ──────────────────────────────────────────
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"
# Embedding model for document RAG + Advisor Clone:  ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL="nomic-embed-text"

# ─── ChromaDB (Vector DB for RAG) ────────────────────────────────
# NOTE: ChromaDB runs on port 8001 locally (port 8000 is used by ML service)
CHROMA_URL="http://localhost:8001"

# ─── ML Service (Python FastAPI) ─────────────────────────────────
# NOTE: ML service runs on port 8000. Must be different from CHROMA_URL.
ML_SERVICE_URL="http://localhost:8000"

# ─── External APIs ───────────────────────────────────────────────
HUGGINGFACE_API_KEY="hf_REPLACE_WITH_YOUR_KEY"

# ─── SMS Gateway (for OTP delivery) ──────────────────────────────
# MSG91 (recommended for India) — get credentials from msg91.com
MSG91_AUTH_KEY="REPLACE_WITH_MSG91_AUTH_KEY"
MSG91_TEMPLATE_ID="REPLACE_WITH_TEMPLATE_ID"
MSG91_SENDER_ID="FINSTH"
# When MSG91 is not configured and NODE_ENV is not "production", the OTP is
# returned in the /auth/send-otp response (and logged) so the apps can be demoed.

# ─── Server ──────────────────────────────────────────────────────
PORT=3001
HOST="0.0.0.0"
NODE_ENV="development"

# ─── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
